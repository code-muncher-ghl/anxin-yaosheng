# 环境变量模板：复制为 .env 后填写
# 任何 OpenAI-Compatible 服务都可以直接接入，切换供应商只改这里

# ---- 方案 A：火山方舟（豆包）----
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=doubao-seed-1-6-flash-250715
# LLM_VISION_MODEL=doubao-1-5-vision-pro-32k-250115

# ---- 方案 B：DeepSeek（性价比高，无视觉）----
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ---- 方案 C：智谱 GLM-4V（有视觉，中文强）----
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4v-flash

# ---- 方案 D：本地 Ollama（Qwen2.5-VL，完全离线）----
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5vl:7b

LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=sk-your-key
LLM_MODEL=doubao-seed-1-6-flash-250715
LLM_VISION_MODEL=doubao-1-5-vision-pro-32k-250115
LLM_VERIFY_MODEL=doubao-seed-1-6-flash-250715

# 语音（edge-tts 免费，无需 Key）
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=-12%

# 限流（免费额度建议保持 1.0 秒间隔）
LLM_MIN_INTERVAL=1.0
LLM_MAX_RETRIES=4
